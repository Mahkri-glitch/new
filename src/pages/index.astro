---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import EventsSection from '../components/EventsSection.astro';
import WhyJoinSection from '../components/WhyJoinSection.astro';
import NewMemberPreview from '../components/NewMemberPreview.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { missionCards } from '../lib/data.ts';
import { navLinks } from '../lib/data.ts';
import { WhatToExpectIcon } from '../lib/icons.tsx';
import DottedSurface from '../components/ui/DottedSurface.astro';
import '../styles/globals.css';
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <AboutSection missionCards={missionCards} />
    <EventsSection eventsList={[]} />
    <WhyJoinSection benefitsList={[]} />
    <NewMemberPreview checklistList={[]} />
    <ContactSection />
  </main>
  <Footer />
</Layout>
