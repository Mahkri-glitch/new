---
import { navLinks } from '../../lib/data.ts';
---

<header class="fixed top-0 inset-x-0 z-50 hidden sm:block border-b border-zinc-800 bg-black/80 backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-6 h-16 flex items-center justify-between">
    <a href="/" aria-label="SCRO homepage" class="flex items-center gap-3">
      <img src="/scro-logo.png" alt="SCRO @ UCF" class="rounded" width="24" height="24" />
      <span class="text-sm font-semibold tracking-wide text-zinc-100">SCRO</span>
    </a>

    <nav class="flex items-center gap-6">
      {navLinks.filter((l) => l.label !== 'Home').map((link) => (
        <a
          key={link.label}
          href={link.href}
          class="text-sm font-medium text-zinc-400 hover:text-white transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://discord.gg/F9PTT3FJFS"
        target="_blank"
        rel="noreferrer"
        class="text-sm font-medium text-black bg-white px-4 py-1.5 rounded-md hover:bg-zinc-200 transition-colors"
      >
        Join Discord
      </a>
    </nav>
  </div>
</header>
