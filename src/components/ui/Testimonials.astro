---
import { cn } from '../../lib/utils';

interface Testimonial {
  id: number;
  quote: string;
  name: string;
  role: string;
  imageSrc: string;
}

export function TestimonialSection({ title, subtitle, testimonials }: { title: string; subtitle: string; testimonials: Testimonial[] }) {
  return (
    <section class="w-full py-16 sm:py-24">
      <div class="container mx-auto max-w-6xl px-4 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{title}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">{subtitle}</p>

        <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((testimonial) => (
            <div
              key={testimonial.id}
              class="relative overflow-hidden rounded-lg bg-card shadow-sm h-[480px]"
            >
              <img
                src={testimonial.imageSrc}
                alt={testimonial.name}
                class="object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/40 to-transparent" />
              <div class="absolute bottom-0 left-0 right-0 p-6 text-left text-white">
                <blockquote class="text-base font-medium leading-relaxed">{testimonial.quote}</blockquote>
                <figcaption class="mt-4">
                  <p class="font-semibold">
                    &mdash; {testimonial.name},
                    <span class="ml-1 text-white/60">{testimonial.role}</span>
                  </p>
                </figcaption>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
}
