---
import { cn } from '../../lib/utils';

interface Testimonial {
  id: number;
  quote: string;
  name: string;
  role: string;
  imageSrc: string;
}

interface Props {
  title: string;
  subtitle: string;
  testimonials: Testimonial[];
}

const { title, subtitle, testimonials } = Astro.props;
---

<section class="w-full py-16 sm:py-24">
  <div class="container mx-auto max-w-6xl px-4 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">{subtitle}</p>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((testimonial) => (
        <div
          class="relative overflow-hidden rounded-xl bg-zinc-900 border border-zinc-800 h-[480px]"
        >
          <img
            src={testimonial.imageSrc}
            alt={testimonial.name}
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent" />
          <div class="absolute bottom-0 left-0 right-0 p-6 text-left text-white">
            <blockquote class="text-base font-medium leading-relaxed italic">"{testimonial.quote}"</blockquote>
            <figcaption class="mt-4">
              <p class="font-semibold">
                {testimonial.name}
              </p>
              <p class="text-sm text-zinc-400">{testimonial.role}</p>
            </figcaption>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
