---
import { ChevronDownIcon } from '../../lib/icons.tsx';

interface AccordionItem {
  question: string;
  answer: string;
}

interface AccordionProps {
  items: AccordionItem[];
}

export function Accordion({ items }: AccordionProps) {
  return (
    <div class="space-y-3">
      {items.map((item) => (
        <div
          key={item.question}
          class="rounded-xl border border-[rgba(255,213,30,0.35)] bg-[rgba(0,0,0,0.9)]"
        >
          <button
            type="button"
            class="flex w-full items-center justify-between gap-3 px-4 py-4 text-left text-sm font-semibold text-[var(--scro-white)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--scro-gold)] cursor-pointer"
            onClick={() => {
              const el = document.querySelector(`[data-faq-question="${item.question}"]`);
              el?.classList.toggle('hidden');
            }}
          >
            <span>{item.question}</span>
            <ChevronDownIcon class="h-4 w-4 text-[var(--scro-gold)] transition-transform rotate-180" />
          </button>
          <p class="hidden px-4 pb-4 text-sm text-[rgba(255,255,255,0.82)]">{item.answer}</p>
        </div>
      ))}
    </div>
  );
}
---
